# AstroCut Server-Side AI Provider Environment Variables
# Copy this file to .env.local (never commit .env or .env.local to Git).
# Keys set here are read ONLY by the local Node server layer and never exposed to frontend JavaScript.

# 1. Google Gemini API (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# 2. OpenAI API (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# 3. Anthropic Claude API (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# 4. Groq API (https://console.groq.com/keys)
GROQ_API_KEY=

# 5. OpenRouter API (https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# 6. DeepSeek API (https://platform.deepseek.com/)
DEEPSEEK_API_KEY=

# 7. Mistral API (https://console.mistral.ai/)
MISTRAL_API_KEY=

# 8. Ollama Local API (default: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# Optional: protect /api/ai/* endpoints with a local bearer token if desired
ASTROCUT_API_TOKEN=

# Optional Phase 7 Local Transcription Paths
ASTROCUT_FFMPEG_PATH=ffmpeg
ASTROCUT_PYTHON_BIN=
ASTROCUT_WHISPER_CACHE_DIR=.astrocut/models/whisper
